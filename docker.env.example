# 复制本文件为 docker.env 后再填写。
# 迁移现有数据库时，AI_CONFIG_ENCRYPTION_KEY 必须使用原 .env 中的值。

DATABASE_URL="file:/data/prisma/prod.db"
SESSION_SECRET="CHANGE_ME"
AI_CONFIG_ENCRYPTION_KEY="CHANGE_ME"
APP_URL="https://training.example.com"
NEXT_PUBLIC_APP_URL="https://training.example.com"
SESSION_COOKIE_SECURE="true"

# Nginx 反向代理模式必须绑定 127.0.0.1；端口选择未被其他系统占用的宿主机端口。
APP_BIND_ADDRESS="127.0.0.1"
APP_PORT="3000"

# true：第一次启动空数据库时写入 admin/teacher/student 演示账号。
# false：迁移已有 prod.db 时使用，不写演示数据。
INIT_DEMO_DATA="false"

AI_MODE="openai"
OPENAI_BASE_URL="https://api.deepseek.com"
OPENAI_API_KEY=""
OPENAI_MODEL="deepseek-chat"
